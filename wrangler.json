{
  "$schema": "./cloudflare/node_modules/wrangler/config-schema.json",
  "name": "parcel",
  "main": "cloudflare/v3/worker.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/v3-web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parcel",
      "database_id": "0be1e08c-5edd-4f5d-a4b3-2c1d37641428",
      "migrations_dir": "cloudflare/v3/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "parcel"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "PUBLIC_URL": "https://s.979863.xyz",
    "ADMIN_AUTH": "totp",
    "R2_ENDPOINT": "https://1d500b4f7e10763ba4ce586ad6ee4c3f.r2.cloudflarestorage.com",
    "R2_BUCKET_NAME": "parcel",
    "STORAGE_QUOTA_BYTES": "5000000000",
    "MAX_FILE_BYTES": "8589934592",
    "ACTIVE": "true",
    "WORKERS_PLAN": "free",
    "CLEANUP_BATCH_SIZE": "1"
  },
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "7391",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "ADMIN_LIMITER",
      "namespace_id": "7392",
      "simple": {
        "limit": 3000,
        "period": 60
      }
    }
  ],
    "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
